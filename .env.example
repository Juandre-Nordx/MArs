# Local development only; replace credentials for deployment.
DATABASE_URL=postgresql://mars:mars@localhost:5432/mars?schema=public
PORT=3001

# Exact browser origin for administration; use your HTTPS public domain in production.
ADMIN_ORIGIN=http://localhost:5173
# Optional artwork limits in bytes, each bounded to 1 KiB–8 MiB.
# Input counts the decoded upload before processing. Output counts the processed PNG.
ADMIN_UPLOAD_INPUT_LIMIT_BYTES=8388608
# Processed PNG limit for resource and building icons.
ADMIN_UPLOAD_OUTPUT_LIMIT_BYTES=2097152
# Processed PNG limit for isometric building and industry sprites.
ADMIN_UPLOAD_SPRITE_OUTPUT_LIMIT_BYTES=8388608
# Legacy ADMIN_UPLOAD_LIMIT_BYTES sets the icon output limit when the icon variable is unset.

# Artwork defaults to PostgreSQL. Set on @mars/api after mounting its Railway volume.
# ASSET_STORAGE_DRIVER=volume
# ASSET_STORAGE_PATH=/data/uploads
# New file-backed artwork is stored under /data/uploads/catalogue-assets/.
